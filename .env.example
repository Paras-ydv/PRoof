# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://proof:proof@localhost:5433/proof
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
# Public source repo: "How to fix" links point at docs/rules there
REPO_URL=https://github.com/proof-dev/proof

# From your GitHub App settings page
GITHUB_APP_ID=
GITHUB_APP_SLUG=proof
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# openssl rand -base64 32
ENCRYPTION_KEY=

# Optional: email delivery
SMTP_URL=
EMAIL_FROM=PRoof <noreply@example.com>

# Optional: where feature requests are forwarded, and the public contact address
TEAM_NOTIFY_WEBHOOK=
CONTACT_EMAIL=
