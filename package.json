{
  "name": "proof",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "pnpm --parallel --filter @proof/server --filter @proof/web dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:migrate": "pnpm --filter @proof/db migrate"
  }
}
